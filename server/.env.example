PORT=3001
DATABASE_URL=postgresql://user:pass@localhost:5432/nearby_social
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-this-to-a-random-string-in-production
CLIENT_URL=http://localhost:5173

# Optional — avatar uploads (Supabase Storage). Leave unset to disable
# uploads; everything else still works. Project Settings -> API for both.
# SUPABASE_SERVICE_ROLE_KEY is a secret — server-side only, never expose it
# to the client.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
